# ---------------------------------------------------------------------------
# Smart Substitution Engine — Python AI Service configuration
# Copy to ".env" and adjust. All variables are prefixed with SSE_.
# ---------------------------------------------------------------------------

# --- Ollama (text generation only) ---
SSE_OLLAMA_BASE_URL=http://localhost:11434
SSE_CHAT_MODEL=qwen3.5:0.8b
SSE_OLLAMA_TIMEOUT=30

# --- Embeddings (semantic similarity) ---
SSE_EMBEDDING_BACKEND=sentence_transformers   # or "ollama"
SSE_EMBEDDING_MODEL=BAAI/bge-m3               # HF id for sentence-transformers
SSE_EMBEDDING_DEVICE=                          # blank=auto (cuda if available), or cpu/cuda

# --- Vector store (Milvus) ---
SSE_ENABLE_MILVUS=true                         # false -> in-process embeddings only (no vector DB)
SSE_MILVUS_URI=http://localhost:19530
SSE_MILVUS_TOKEN=                              # "user:password" if auth is enabled
SSE_MILVUS_COLLECTION=product_embeddings
SSE_EMBEDDING_DIM=1024                         # bge-m3 = 1024

# --- MongoDB (direct catalog access for POST /recommendations/auto) ---
SSE_ENABLE_MONGO=true
# Local Docker mongo by default. For Atlas use mongodb+srv://user:pass@cluster.../
SSE_MONGO_URI=mongodb://localhost:27017
SSE_MONGO_DB=hackathon_db

# --- Feature toggles (graceful degradation if disabled / unavailable) ---
SSE_ENABLE_EMBEDDINGS=true
SSE_ENABLE_LLM_EXPLANATIONS=true

# --- LLM generation ---
SSE_LLM_TEMPERATURE=0.2
SSE_LLM_NUM_PREDICT=180
# Disable chain-of-thought for reasoning models (qwen3.5) -> direct answers
SSE_LLM_DISABLE_REASONING=true

# --- Scoring weights (max points per dimension; default sum = 93) ---
SSE_W_CATEGORY=30
SSE_W_CONTRACT=25
SSE_W_PRICE=20
SSE_W_STOCK=10
SSE_W_UNIT_PACK=8

# --- Business thresholds ---
SSE_MAX_PRICE_INCREASE_PCT=0.25     # reject candidates >25% pricier than requested
SSE_ALLOW_CROSS_CATEGORY=true       # allow semantically-compatible categories
SSE_CATEGORY_SEMANTIC_THRESHOLD=0.7 # min cosine sim to accept a cross-category item (tuned for bge-m3)
SSE_DEFAULT_MAX_RESULTS=3
